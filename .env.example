# Configuración de entorno para el proyecto Futbol-Torneos
# Copia este archivo a .env y ajusta los valores según tu instalación.
#
# IMPORTANTE: este archivo SI se versiona en git, a diferencia de .env.
# Nunca debe contener credenciales reales, solo valores de ejemplo.

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=genera-tu-propia-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

DB_NAME=nombre-de-la-base
DB_USER=usuario-de-la-base
DB_PASSWORD=contrasena-de-la-base
DB_HOST=localhost
DB_PORT=5432

# Carpeta donde se guardan las imagenes que suben los usuarios (escudos,
# logos y fotos). Conviene que este FUERA del proyecto: si esta adentro, un
# despliegue o un git pull puede borrarla con todas las imagenes.
# Si se deja vacia se usa media/ dentro del proyecto.
MEDIA_ROOT=/var/www/futbol/media
