# Configuración de entorno para el proyecto Futbol-Torneos
# Copia este archivo a .env y ajusta los valores según tu instalación.
#
# IMPORTANTE: este archivo SI se versiona en git, a diferencia de .env.
# Nunca debe contener credenciales reales, solo valores de ejemplo.

# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=genera-tu-propia-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Dominios completos (con esquema) desde los que se puede enviar formularios.
# Necesario en produccion si el sitio se sirve por HTTPS detras de un proxy
# (IIS, nginx, etc). En local normalmente se deja vacio.
CSRF_TRUSTED_ORIGINS=

# Marca las cookies de sesion y de CSRF como "solo por HTTPS", para que el
# navegador se niegue a mandarlas si alguien entra por http:// sin la ese.
# True en produccion. En desarrollo va False: ahi se entra por http://localhost
# y con True el navegador no guardaria la sesion, o sea que no se podria entrar.
COOKIES_SEGURAS=False

DB_NAME=nombre-de-la-base
DB_USER=usuario-de-la-base
DB_PASSWORD=contrasena-de-la-base
DB_HOST=localhost
DB_PORT=5432

# Carpeta donde se guardan las imagenes que suben los usuarios (escudos,
# logos y fotos). Conviene que este FUERA del proyecto: si esta adentro, un
# despliegue o un git pull puede borrarla con todas las imagenes.
# Si se deja vacia se usa media/ dentro del proyecto.
MEDIA_ROOT=/var/www/futbol/media

# Intentos fallidos de login antes de bloquear, y cuanto dura el bloqueo
# en horas (0.25 = 15 minutos).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HORAS=0.25

# Manda a https:// a quien entre por http://. True en produccion.
# En desarrollo va False: ahi se trabaja sobre http://localhost y con True
# el navegador quedaria redirigido a un https que no existe en local.
FORZAR_HTTPS=False

# Minutos de INACTIVIDAD antes de que se cierre la sesion sola, y cuantos
# segundos antes se avisa en pantalla con la cuenta regresiva.
# El reloj se reinicia con cada peticion, asi que a quien esta trabajando
# no lo saca nunca: solo salta si deja la maquina sola.
SESION_MINUTOS=20
SESION_AVISO_SEGUNDOS=120

# True: cerrar el navegador tambien cierra la sesion.
SESION_CIERRA_CON_NAVEGADOR=True

# Donde se guardan las bitacoras (seguridad.log y errores.log).
# Vacio = carpeta logs/ dentro del proyecto. NUNCA apuntarla dentro de
# static/ ni de media/: Django sirve esas dos por URL y los logs quedarian
# descargables desde el navegador.
CARPETA_LOGS=

# Ruta del panel de administracion de Django, SIN barras.
# En produccion conviene una que no se pueda adivinar: en /admin/ la
# encuentra cualquier escaneo automatico en el primer intento.
RUTA_ADMIN=admin
