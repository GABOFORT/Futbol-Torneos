__pycache__/
*.pyc
db.sqlite3
venv/
futbol-ligas/
.env
# Tambien cualquier copia o respaldo del .env: `.env` a secas solo cubre ese
# nombre exacto, asi que un `.env.respaldo-...` o un `.env.bak` se habrian
# subido con la SECRET_KEY y la contrasena de la base adentro.
# `.env.example` se salva aparte: ese SI va al repositorio, con valores falsos.
.env.*
!.env.example
tools/tailwindcss.exe
.vscode/
# Credenciales generadas: nunca al repositorio
credenciales-*.csv

# Imagenes que suben los usuarios: van fuera del proyecto (ver MEDIA_ROOT en .env)
media/

# Generados por collectstatic / por correr el servidor: no van al repositorio
staticfiles/
waitress-*.log

# Bitacoras de seguridad y de errores (ver LOGGING en futbol/settings.py).
# Nunca al repositorio: llevan nombres de usuario, IPs y trazas de error.
logs/
